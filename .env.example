DOUBAO_API_KEY=your_doubao_api_key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-1-8-251228
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_KEY=your_dashscope_api_key
DATABASE_URL=sqlite:///./zhisaotong.db
REDIS_URL=redis://localhost:6379
JWT_SECRET_KEY=your-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Tavily search API (sign up at app.tavily.com)
TAVILY_API_KEY=your_tavily_api_key

# LangSmith tracing (optional — sign up at smith.langchain.com)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=zhisaotong-dev
