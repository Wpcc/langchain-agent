# LLM — any OpenAI-compatible provider (set base_url + model names to your provider)
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.your-provider.com/v1
LLM_MODEL_PRO=your_pro_model    # main agent, complex reasoning
LLM_MODEL_MINI=your_mini_model  # RAG summarization, structured tasks
LLM_MODEL_LITE=your_lite_model  # simple / high-frequency tasks
LLM_MODEL_CODE=your_code_model  # code generation / analysis
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_KEY=your_dashscope_api_key
DATABASE_URL=sqlite:///./zhisaotong.db
REDIS_URL=redis://localhost:6379
JWT_SECRET_KEY=your-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Tavily search API (sign up at app.tavily.com)
TAVILY_API_KEY=your_tavily_api_key

# LangSmith tracing (optional — sign up at smith.langchain.com)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=zhisaotong-dev
